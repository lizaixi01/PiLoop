{
  "name": "piloop",
  "version": "0.1.3",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lizaixi01/PiLoop.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "piloop": "bin/piloop.mjs"
  },
  "files": [
    "bin",
    "lib/server/cli.js",
    "lib/server/tui.js",
    "lib/server/native-memory.js",
    "lib/server/scope.js",
    "lib/server/updates.js",
    "README.md",
    "LICENSE"
  ],
  "description": "Pi-native CLI with proactive execution guidance and scoped preference memory.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts --dev",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json",
    "prepack": "npm run build",
    "start": "tsx --env-file-if-exists=.env server/cli.ts",
    "web": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build:web": "vite build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@sinclair/typebox": "^0.34.41",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
